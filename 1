<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Easy Gift</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(145deg, #0a0a0f 0%, #1a1a2e 100%);
            color: white;
            min-height: 100vh;
            padding: 20px;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 20px;
        }
        
        .header h1 {
            font-size: 24px;
            font-weight: 700;
            background: linear-gradient(90deg, #f7971e, #ffd200);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .header .close-btn {
            background: rgba(255,255,255,0.1);
            border: none;
            color: white;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 14px;
            cursor: pointer;
        }
        
        .capsule-card {
            background: linear-gradient(145deg, #1e1e3a, #2a2a4a);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.05);
            position: relative;
            overflow: hidden;
        }
        
        .capsule-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(247, 151, 30, 0.1), transparent 70%);
            pointer-events: none;
        }
        
        .capsule-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .capsule-title .badge {
            background: #f7971e;
            color: #000;
            font-size: 12px;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 600;
        }
        
        .capsule-subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 14px;
            margin-bottom: 4px;
        }
        
        .capsule-price {
            font-size: 32px;
            font-weight: 700;
            color: #ffd700;
            margin: 12px 0;
        }
        
        .capsule-price span {
            font-size: 16px;
            color: rgba(255,255,255,0.5);
            font-weight: 400;
        }
        
        .progress-section {
            margin: 16px 0;
        }
        
        .progress-bar {
            width: 100%;
            height: 8px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            overflow: hidden;
            margin: 8px 0;
        }
        
        .progress-bar .fill {
            height: 100%;
            width: 0.01%;
            background: linear-gradient(90deg, #f7971e, #ffd200);
            border-radius: 10px;
            transition: width 0.5s ease;
        }
        
        .progress-text {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: rgba(255,255,255,0.6);
        }
        
        .promo-section {
            background: rgba(247, 151, 30, 0.1);
            border: 1px solid rgba(247, 151, 30, 0.2);
            border-radius: 16px;
            padding: 16px;
            margin: 16px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .promo-section .promo-text {
            font-size: 14px;
        }
        
        .promo-section .promo-text strong {
            color: #ffd700;
        }
        
        .promo-section .time {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }
        
        .get-gift-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(90deg, #f7971e, #ffd200);
            border: none;
            border-radius: 16px;
            color: #000;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 12px;
        }
        
        .get-gift-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 30px rgba(247, 151, 30, 0.3);
        }
        
        .get-gift-btn:active {
            transform: scale(0.98);
        }
        
        .footer-text {
            text-align: center;
            color: rgba(255,255,255,0.3);
            font-size: 12px;
            margin-top: 20px;
        }
        
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.9);
            color: white;
            padding: 14px 28px;
            border-radius: 14px;
            font-size: 14px;
            display: none;
            border: 1px solid rgba(255,255,255,0.1);
            z-index: 999;
        }
        
        .toast.show {
            display: block;
            animation: slideUp 0.3s ease;
        }
        
        @keyframes slideUp {
            from { transform: translateX(-50%) translateY(20px); opacity: 0; }
            to { transform: translateX(-50%) translateY(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>⭐ Easy Gift</h1>
        <button class="close-btn" onclick="closeApp()">✕ Закрыть</button>
    </div>
    
    <div class="capsule-card">
        <div class="capsule-title">
            🎁 67 Capsule
            <span class="badge">Limi</span>
        </div>
        <div class="capsule-subtitle">СИКСЕВЕН КАПСУЛА уже в приложении</div>
        <div class="capsule-price">
            5 / 50000
            <span>звёзд</span>
        </div>
        
        <div class="progress-section">
            <div class="progress-bar">
                <div class="fill" id="progressFill" style="width: 0.01%"></div>
            </div>
            <div class="progress-text">
                <span>0 из 50000</span>
                <span id="percentText">0.01%</span>
            </div>
        </div>
    </div>
    
    <div class="promo-section">
        <div class="promo-text">
            🎯 <strong>СИКСЕВЕН КАПСУЛА</strong> уже в приложении<br>
            <span style="font-size:12px;color:rgba(255,255,255,0.6);">Успей забрать 67 NFT почти бесплатно!</span>
        </div>
        <div class="time">23:29</div>
    </div>
    
    <button class="get-gift-btn" onclick="getGift()">
        🎁 Получить подарки
    </button>
    
    <div class="footer-text">By launching this mini app, you agree to the Terms of Service for Mini Apps.</div>
    
    <div class="toast" id="toast"></div>
    
    <script>
        // ========== TELEGRAM WEB APP ==========
        let tg = window.Telegram?.WebApp;
        
        if (tg) {
            tg.ready();
            tg.expand();
        }
        
        // ========== ПРОГРЕСС (АНИМАЦИЯ) ==========
        let currentProgress = 0;
        const targetProgress = 50000;
        
        function updateProgress(value) {
            const percent = (value / targetProgress) * 100;
            document.getElementById('progressFill').style.width = percent + '%';
            document.getElementById('percentText').textContent = percent.toFixed(2) + '%';
        }
        
        // Имитация загрузки прогресса
        let progress = 0;
        const interval = setInterval(() => {
            progress += Math.random() * 50;
            if (progress > targetProgress) {
                progress = targetProgress;
                clearInterval(interval);
            }
            updateProgress(progress);
        }, 100);
        
        // ========== ПОЛУЧЕНИЕ ПОДАРКА ==========
        function getGift() {
            showToast('🎁 Подарок получен! +1 звезда!');
            
            // Отправка данных в бота
            if (tg) {
                tg.sendData(JSON.stringify({
                    action: 'get_gift',
                    timestamp: Date.now()
                }));
            }
            
            // Анимация кнопки
            const btn = document.querySelector('.get-gift-btn');
            btn.textContent = '✅ Подарок получен!';
            btn.style.background = 'linear-gradient(90deg, #00b894, #00cec9)';
            btn.disabled = true;
            
            setTimeout(() => {
                btn.textContent = '🎁 Получить подарки';
                btn.style.background = 'linear-gradient(90deg, #f7971e, #ffd200)';
                btn.disabled = false;
            }, 3000);
        }
        
        // ========== TOAST УВЕДОМЛЕНИЕ ==========
        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }
        
        // ========== ЗАКРЫТИЕ ==========
        function closeApp() {
            if (tg) {
                tg.close();
            } else {
                window.close();
            }
        }
        
        // ========== ОБРАБОТКА ДАННЫХ ОТ БОТА ==========
        if (tg) {
            tg.onEvent('mainButtonClicked', function() {
                getGift();
            });
        }
        
        console.log('Easy Gift Mini App loaded!');
    </script>
</body>
</html>
